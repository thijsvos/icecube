# Brewfile — developer tools needed to build Zephyr. Install with: brew bundle
#
# Expected versions (verified 2026-07-23): xcodegen 2.46.0. Homebrew installs the
# latest formula and cannot pin; if a newer xcodegen ever changes generation
# behavior, check its release notes against project.yml before upgrading.
brew "xcodegen"
brew "swiftformat"
